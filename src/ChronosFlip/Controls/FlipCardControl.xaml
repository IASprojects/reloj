<UserControl
    x:Class="ChronosFlip.Controls.FlipCardControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <Grid Width="{StaticResource CardWidth}"
              Height="{StaticResource CardHeight}">
            <Border Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" />
            <Rectangle Height="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       Fill="{StaticResource FlipSplitBrush}"
                       IsHitTestVisible="False" />
            <TextBlock Text="{Binding Value, ElementName=Root}"
                       Foreground="{StaticResource TextOnCardBrush}"
                       FontFamily="{StaticResource SpaceMonoFont}"
                       FontSize="64"
                       FontWeight="Bold"
                       CharacterSpacing="-50"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Foreground="{StaticResource LabelTextBrush}"
                   FontFamily="{StaticResource JetBrainsMonoFont}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   CharacterSpacing="100"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>