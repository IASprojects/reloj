<UserControl
    x:Class="ChronosFlip.Controls.NeonGlowBorder"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The 12px Shell padding reserves a glow zone. Each glow Border uses a
        negative margin equal to its thickness so its colored band renders OUTWARD
        from the card edge, inside the window (never clipped, never a filled blob).
        Corner radius = card radius (4) + band distance from the card edge.
    -->
    <Grid x:Name="Shell" Padding="12">
        <Border x:Name="GlowOuter"
                BorderBrush="{StaticResource NeonAccentBrush}"
                BorderThickness="8"
                CornerRadius="12"
                Opacity="0.04"
                Margin="-8"
                IsHitTestVisible="False" />
        <Border x:Name="GlowMid"
                BorderBrush="{StaticResource NeonAccentBrush}"
                BorderThickness="6"
                CornerRadius="10"
                Opacity="0.07"
                Margin="-6"
                IsHitTestVisible="False" />
        <Border x:Name="GlowNear"
                BorderBrush="{StaticResource NeonAccentBrush}"
                BorderThickness="4"
                CornerRadius="8"
                Opacity="0.11"
                Margin="-4"
                IsHitTestVisible="False" />
        <Border x:Name="GlowCore"
                BorderBrush="{StaticResource NeonAccentBrush}"
                BorderThickness="2"
                CornerRadius="6"
                Opacity="0.16"
                Margin="-2"
                IsHitTestVisible="False" />
        <Border x:Name="StrokeBorder"
                BorderBrush="{StaticResource NeonAccentBrush}"
                BorderThickness="{StaticResource NeonStrokeThickness}"
                CornerRadius="{StaticResource CardCornerRadius}"
                IsHitTestVisible="False" />
        <ContentPresenter Content="{x:Bind InnerContent, Mode=OneWay}" />
    </Grid>
</UserControl>
