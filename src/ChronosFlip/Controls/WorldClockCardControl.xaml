<UserControl
    x:Class="ChronosFlip.Controls.WorldClockCardControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ChronosFlip.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Grid Width="{StaticResource WorldClockCardWidth}"
              Height="{StaticResource WorldClockCardHeight}">
            <Border x:Name="CardBorder"
                    Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" />
            <Rectangle Height="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       Fill="{StaticResource FlipSplitBrush}"
                       IsHitTestVisible="False" />
            <TextBlock Text="{Binding Time, ElementName=Root}"
                       Foreground="{StaticResource TextOnCardBrush}"
                       FontFamily="{StaticResource SpaceMonoFont}"
                       FontSize="40"
                       FontWeight="Bold"
                       CharacterSpacing="-30"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <FontIcon Glyph="&#xE916;"
                      FontSize="12"
                      Foreground="{StaticResource NeonAccentBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="8"
                      Visibility="{Binding HasAlarm, ElementName=Root, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Border x:Name="RingingBadge"
                    Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource NeonAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"
                    Visibility="{Binding IsAlarmRinging, ElementName=Root, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="RINGING"
                               Foreground="{StaticResource NeonAccentBrush}"
                               FontFamily="{StaticResource JetBrainsMonoFont}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               CharacterSpacing="60"
                               VerticalAlignment="Center" />
                    <Button Content="STOP"
                            Command="{Binding DismissAlarmCommand}"
                            Background="Transparent"
                            BorderBrush="{StaticResource NeonAccentBrush}"
                            BorderThickness="1"
                            Padding="6,1"
                            FontFamily="{StaticResource JetBrainsMonoFont}"
                            FontSize="9"
                            FontWeight="SemiBold"
                            CharacterSpacing="40" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding ZoneLabel, ElementName=Root}"
                   Foreground="{StaticResource LabelTextBrush}"
                   FontFamily="{StaticResource JetBrainsMonoFont}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   CharacterSpacing="80"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center"
                   MaxWidth="{StaticResource WorldClockCardWidth}" />
        <TextBlock Text="{Binding Offset, ElementName=Root}"
                   Foreground="{StaticResource LabelTextBrush}"
                   FontFamily="{StaticResource JetBrainsMonoFont}"
                   FontSize="9"
                   CharacterSpacing="40"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>