<UserControl
    x:Class="ChronosFlip.Controls.WorldClockCardControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <Grid Width="{StaticResource WorldClockCardWidth}"
              Height="{StaticResource WorldClockCardHeight}">
            <Border Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" />
            <Rectangle Height="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       Fill="{StaticResource FlipSplitBrush}"
                       IsHitTestVisible="False" />
            <TextBlock Text="{Binding Time, ElementName=Root}"
                       Foreground="{StaticResource TextOnCardBrush}"
                       FontFamily="{StaticResource SpaceMonoFont}"
                       FontSize="40"
                       FontWeight="Bold"
                       CharacterSpacing="-30"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding ZoneLabel, ElementName=Root}"
                   Foreground="{StaticResource LabelTextBrush}"
                   FontFamily="{StaticResource JetBrainsMonoFont}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   CharacterSpacing="80"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center"
                   MaxWidth="{StaticResource WorldClockCardWidth}" />
        <TextBlock Text="{Binding Offset, ElementName=Root}"
                   Foreground="{StaticResource LabelTextBrush}"
                   FontFamily="{StaticResource JetBrainsMonoFont}"
                   FontSize="9"
                   CharacterSpacing="40"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>