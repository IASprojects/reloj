<Window
    x:Class="ChronosFlip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChronosFlip.Controls"
    xmlns:views="using:ChronosFlip.Views">

    <Grid x:Name="RootGrid"
          Background="{StaticResource AppBackgroundBrush}">

        <controls:NeonGlowBorder x:Name="NeonShell"
                                 IsNeonEnabled="{x:Bind ViewModel.NeonEnabled, Mode=OneWay}">
            <controls:NeonGlowBorder.InnerContent>
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource StandardGap}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <controls:FlipCardControl Value="{Binding Hours}" Label="HOURS" />

                    <StackPanel Orientation="Vertical"
                                Spacing="{StaticResource ColonDotGap}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="{StaticResource ColonDotSize}"
                                 Height="{StaticResource ColonDotSize}"
                                 Fill="{StaticResource ColonDotBrush}" />
                        <Ellipse Width="{StaticResource ColonDotSize}"
                                 Height="{StaticResource ColonDotSize}"
                                 Fill="{StaticResource ColonDotBrush}" />
                    </StackPanel>

                    <controls:FlipCardControl Value="{Binding Minutes}" Label="MINUTES" />

                    <StackPanel Orientation="Vertical"
                                Spacing="{StaticResource ColonDotGap}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="{StaticResource ColonDotSize}"
                                 Height="{StaticResource ColonDotSize}"
                                 Fill="{StaticResource ColonDotBrush}" />
                        <Ellipse Width="{StaticResource ColonDotSize}"
                                 Height="{StaticResource ColonDotSize}"
                                 Fill="{StaticResource ColonDotBrush}" />
                    </StackPanel>

                    <controls:FlipCardControl Value="{Binding Seconds}" Label="SECONDS" />
                </StackPanel>
            </controls:NeonGlowBorder.InnerContent>
        </controls:NeonGlowBorder>

        <Button x:Name="SettingsButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0"
                Background="Transparent"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                Width="32"
                Height="32"
                Padding="0"
                Content="&#xE713;"
                FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                FontSize="14">
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <views:SettingsView x:Name="SettingsPanel" />
                </Flyout>
            </Button.Flyout>
        </Button>

    </Grid>
</Window>
