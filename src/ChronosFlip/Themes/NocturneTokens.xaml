<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nocturne Utility tokens: map 1:1 to identyvisual/DEGING.md + AGENTS.md sec. 2. -->

    <!-- Colors -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="FlipSplitBrush" Color="#121212" />
    <SolidColorBrush x:Key="TextOnCardBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="LabelTextBrush" Color="#C4C7C7" />
    <SolidColorBrush x:Key="ColonDotBrush" Color="#444748" />

    <!-- Layout & spacing (4px base unit, DEGING.md) -->
    <x:Double x:Key="CardWidth">148</x:Double>
    <x:Double x:Key="CardHeight">188</x:Double>
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <x:Double x:Key="StandardGap">16</x:Double>
    <x:Double x:Key="ColonDotGap">16</x:Double>
    <x:Double x:Key="ColonDotSize">12</x:Double>

    <!-- Typography -->
    <FontFamily x:Key="SpaceMonoFont">ms-appx:///Assets/Fonts/SpaceMono-Bold.ttf#Space Mono</FontFamily>
    <FontFamily x:Key="JetBrainsMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-SemiBold.ttf#JetBrains Mono</FontFamily>
</ResourceDictionary>