<UserControl
    x:Class="ChronosFlip.Views.AlarmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ChronosFlip.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Width="360" Spacing="12">
        <TextBlock Text="ALARMS"
                   Foreground="{StaticResource TextOnCardBrush}"
                   FontFamily="{StaticResource SpaceMonoFont}"
                   FontSize="16"
                   FontWeight="Bold"
                   CharacterSpacing="60" />

        <StackPanel Spacing="6">
            <TextBlock Text="SCHEDULED"
                       Foreground="{StaticResource LabelTextBrush}"
                       FontFamily="{StaticResource JetBrainsMonoFont}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       CharacterSpacing="100" />
            <ListView x:Name="AlarmList"
                      MaxHeight="252"
                      SelectionMode="None"
                      ItemsSource="{Binding Alarms}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardSurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="10,6"
                                Margin="0,2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE916;"
                                                  FontSize="11"
                                                  Foreground="{StaticResource NeonAccentBrush}"
                                                  Visibility="{Binding IsRinging, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextOnCardBrush}"
                                                   FontFamily="{StaticResource JetBrainsMonoFont}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="40"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ZoneTimeText}"
                                               Foreground="{StaticResource LabelTextBrush}"
                                               FontFamily="{StaticResource JetBrainsMonoFont}"
                                               FontSize="10"
                                               CharacterSpacing="30" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{Binding Enabled, Mode=OneWay}"
                                              Tag="{Binding}"
                                              Toggled="OnAlarmToggleChanged"
                                              OffContent=""
                                              OnContent=""
                                              MinWidth="0"
                                              MinHeight="24"
                                              Padding="0"
                                              VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Content="STOP"
                                            Tag="{Binding}"
                                            Click="OnDismissAlarmClicked"
                                            Visibility="{Binding IsRinging, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource NeonAccentBrush}"
                                            BorderThickness="1"
                                            Padding="8,2"
                                            FontFamily="{StaticResource JetBrainsMonoFont}"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            CharacterSpacing="60" />
                                    <Button Content="&#xE74D;"
                                            Tag="{Binding}"
                                            Click="OnDeleteAlarmClicked"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                            FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" />

        <StackPanel Spacing="6">
            <TextBlock Text="NEW ALARM"
                       Foreground="{StaticResource LabelTextBrush}"
                       FontFamily="{StaticResource JetBrainsMonoFont}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       CharacterSpacing="100" />
            <ComboBox x:Name="ZoneSelector"
                      PlaceholderText="Zone"
                      HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <DatePicker x:Name="AlarmDatePicker"
                            HorizontalAlignment="Stretch" />
                <TimePicker x:Name="AlarmTimePicker" />
            </StackPanel>
            <Button x:Name="AddAlarmButton"
                    Content="ADD ALARM"
                    HorizontalAlignment="Stretch"
                    Click="OnAddAlarmClicked"
                    Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    FontFamily="{StaticResource JetBrainsMonoFont}"
                    FontSize="10"
                    FontWeight="SemiBold"
                    CharacterSpacing="80" />
        </StackPanel>
    </StackPanel>
</UserControl>