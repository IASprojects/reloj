<UserControl
    x:Class="ChronosFlip.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ChronosFlip.Converters"
    xmlns:vm="using:ChronosFlip.Core.ViewModels"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <UserControl.Resources>
        <conv:HexToColorConverter x:Key="HexToColor" />
    </UserControl.Resources>

    <StackPanel Spacing="12" MinWidth="280">
        <ToggleSwitch Header="Neon glow"
                      IsOn="{x:Bind ViewModel.NeonEnabled, Mode=TwoWay}" />

        <TextBlock Text="Accent color"
                   Foreground="{StaticResource LabelTextBrush}"
                   FontFamily="{StaticResource JetBrainsMonoFont}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   CharacterSpacing="100" />

        <controls:ColorPicker Color="{x:Bind ViewModel.NeonHexColor, Mode=TwoWay, Converter={StaticResource HexToColor}}"
                              IsAlphaEnabled="False"
                              IsColorSliderVisible="True"
                              IsColorChannelTextInputVisible="True"
                              IsHexInputVisible="True"
                              MinWidth="260" />
    </StackPanel>
</UserControl>
