<UserControl
    x:Class="ChronosFlip.Views.ZonePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ChronosFlip.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Width="360" Spacing="12">
        <TextBlock Text="WORLD CLOCK"
                   Foreground="{StaticResource TextOnCardBrush}"
                   FontFamily="{StaticResource SpaceMonoFont}"
                   FontSize="16"
                   FontWeight="Bold"
                   CharacterSpacing="60" />

        <StackPanel Spacing="6">
            <TextBlock Text="SHOWING"
                       Foreground="{StaticResource LabelTextBrush}"
                       FontFamily="{StaticResource JetBrainsMonoFont}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       CharacterSpacing="100" />
            <ListView x:Name="TrayList"
                      MaxHeight="132"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource TextOnCardBrush}"
                                           FontFamily="{StaticResource JetBrainsMonoFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="40" />
                                <TextBlock Text="{Binding OffsetText}"
                                           Foreground="{StaticResource LabelTextBrush}"
                                           FontFamily="{StaticResource JetBrainsMonoFont}"
                                           FontSize="10"
                                           CharacterSpacing="40" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="&#xE711;"
                                    Tag="{Binding TimeZoneId}"
                                    Click="OnRemoveZoneClicked"
                                    Visibility="{Binding IsRemovable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                    FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" />

        <StackPanel Spacing="6">
            <TextBlock Text="ADD A ZONE"
                       Foreground="{StaticResource LabelTextBrush}"
                       FontFamily="{StaticResource JetBrainsMonoFont}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       CharacterSpacing="100" />
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search time zones"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ListView x:Name="ZoneList"
                      MaxHeight="264"
                      SelectionMode="None"
                      ItemsSource="{Binding Zones}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource TextOnCardBrush}"
                                           FontFamily="{StaticResource JetBrainsMonoFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="40" />
                                <TextBlock Text="{Binding TimeZoneId}"
                                           Foreground="{StaticResource LabelTextBrush}"
                                           FontFamily="{StaticResource JetBrainsMonoFont}"
                                           FontSize="9"
                                           CharacterSpacing="30" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="ADD"
                                    Tag="{Binding}"
                                    Click="OnAddZoneClicked"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10,2"
                                    FontFamily="{StaticResource JetBrainsMonoFont}"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="60" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </StackPanel>
</UserControl>